@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- hero section -->

<!-- site event information section -->
<section class="event-info-section">
    <!-- first row -->
    <div class="zero-cost-event">
        <div class="textSection">
            <article class="dark-mode-clr font-semibold">Zero cost for free events</article>
            <p class="dark-mode-clr description font-medium">Want to attend a free event? You won’t pay a pence. Ever.
            </p>
        </div>
        <div class="imgSection">
            <img src="/assets/svg/zero-cost-1.png.svg" alt="zero cost event image" class="zero-cost-img">
        </div>
    </div>

    <!-- second row -->
    <div class="virtualEvents">
        <div class="textSection">
            <article class="dark-mode-clr font-semibold">Seamless Virtual Event Hosting</article>
            <p class="dark-mode-clr description font-medium">Present memorable events online with your favorite brand.
            </p>
        </div>
        <div class="imgSection">
            <img src="/assets/svg/Host-virtual-events-1.png.svg" alt="zero cost event image" class="zero-cost-img">
        </div>
    </div>
</section>

<!-- join these brands -->
<section class="join-these-brands">
    <div class="sectionHeader">
        <h2 class="font-semibold dark-mode-clr">Join these brands</h2>
        <p class="description dark-mode-clr">We've had the pleasure of working with industry-defining brands. These are
            just some of them.</p>
    </div>
    <div class="brandsImages">
        <img src="/assets/svg/microsoft.svg" alt="microsoft logo">
        <img src="/assets/svg/spotify-brand.svg" alt="spotify logo">
        <img src="/assets/svg/stripe.svg" alt="stripe logo">
        <img src="/assets/svg/uber.svg" alt="uber logo">
        <img src="/assets/svg/google.svg" alt=" google icon">
        <img src="/assets/svg/grab.svg" alt="grab logo">
        <img src="/assets/svg/medium.svg" alt="medium logo">
        <img src="/assets/svg/youtube.svg" alt="youtube logo">
        <img src="/assets/svg/zoom.svg" alt="zoom icon">
    </div>
</section>

<!-- blog section -->
<section class="blog">
    <div class="blogSection">
        <div class="blogHeader">
            <h3 class="font-semibold dark-mode-clr">Blog</h3>
            <p class="description dark-mode-clr">Check out some of our latest blog posts</p>
        </div>
        <div class="blogPosts">
            <!-- blog containers -->
            <div class="blogContainer">
                <img src="/assets/img/blogpost1.png" alt="blog post image-1">
                <p class="blogTitle cursor-pointer font-semibold dark-mode-clr">6 Strategies to Find Your Conference
                    Keynote and Other Speakers</p>
                <p class="description dark-mode-clr">Planning a conference can be daunting, especially when it comes to
                    finding the right keynote and other speakers. The right speakers set the tone for your event,
                    captivate your audience, and ensure the success of your gathering.</p>
                <div class="dateOfPost font-semibold dark-mode-clr">12 March 2024,Felix Baah</div>
            </div>
            <div class="blogContainer">
                <img src="/assets/img/blogpost2.png" alt="blog post image-2">
                <p class="blogTitle dark-mode-clr cursor-pointer font-semibold">How Successfully Used Paid Marketing to
                    Drive Incremental Ticket Sales</p>
                <p class="description dark-mode-clr">Paid marketing is one of the most effective tools for increasing
                    ticket sales, but it requires a well-executed strategy to make an impact.</p>
                <div class="dateOfPost dark-mode-clr font-semibold">20 June 2024,Elmi Jordan</div>
            </div>
            <div class="blogContainer">
                <img src="/assets/img/blogpost3.png" alt="blog post image-3">
                <p class="blogTitle dark-mode-clr cursor-pointer font-semibold">Introducing Workspaces: Work Smarter,
                    Not Harder with New Navigation</p>
                <p class="description dark-mode-clr">Efficiency in the workplace is essential. Introducing Workspaces, a
                    navigation tool designed to simplify workflows and allow you to work smarter, not harder. </p>
                <div class="dateOfPost font-semibold dark-mode-clr">12 March 2024,Clinton Benjamin</div>
            </div>
        </div>
    </div>
</section>