@page
@model ProfileModel

@{
    ViewData["Title"] = "Profile page";
}
@{
    Layout = null; // This disables the layout for this page
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - soft20181_starter</title>

    <!-- google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <!-- portfolio / desktop icon -->
    <link rel="icon" type="image/webp" sizes="32x32" href="/assets/img/portfolio-site-icon.webp">

    <!-- tailwind css reset -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true">

    <!-- tailwind css reset -->
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true">


    @* Section for CSS Start *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@
    <link rel="stylesheet" href="~/soft20181_starter.styles.css" asp-append-version="true" />
    @* Section for CSS Start *@

</head>

<body id="profile-page" style="background-color: #141D2F;">
    <div class="mainProfileContainer">
        @* profile for users, including their login and logout *@
        <div class="userAction">
            <a class="goBack text-white font-bold cursor-pointer" asp-page="/Index">Go Back</a>
            <form method="post" asp-page-handler="Logout">
                <button type="submit" class="logoutBtn text-white font-bold cursor-pointer">
                    Log Out
                </button>
            </form>
        </div>
        <div class="userProfile">
            <div class="abbreviationContainer text-white font-bold">
                @Model.UserAbbreviation
            </div>
            <div class="userNames text-white font-bold"> @Model.UserFirstName @Model.UserLastName</div>
        </div>

        @* header *@
        <h1 class="font-bold text-center">List Of Attending Events</h1>
        <div class="tickets-list text-white">
            @if (Model.UserTickets.Any())
            {
                <ul>
                    @foreach (var ticket in Model.UserTickets)
                    {
                        <li>
                            <article class="ticket-title cursor-pointer" data-ticket-id="@ticket.TicketID">@ticket.Event.Name </article> <br />
                            <form method="post" asp-page-handler="Cancel" asp-route-id="@ticket.TicketID">
                                <button type="submit" class="btn btn-danger">Cancel Ticket</button>
                            </form>

                            @* hidden Tickets *@
                            <div class="ticket-popup" id="ticket-popup-@ticket.TicketID" style="display: none;">
                                <button class="close-popup float-left text-red-500 font-bold text-xl" data-ticket-id="@ticket.TicketID">&times;</button>
                                <h1 class="text-center font-bold">Ticket</h1>
                                <p><strong>Event:</strong> @ticket.Event.Name</p>
                                <p><strong>Date & Time:</strong> @ticket.Event.Day @ticket.Event.Month @ticket.Event.Year at @ticket.Event.Time</p>
                                <p><strong>Ticket Code:</strong> @ticket.TicketCode</p>
                                <p><strong>Ticket Holder:</strong> @Model.UserFirstName @Model.UserLastName</p>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="no-tickets text-center text-white font-bold">No tickets reserved yet.</p>
            }
        </div>

    </div>

    </div>

    @* Add Site Wide JavaScript Start *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Add Site Wide JavaScript End *@
</body>

</html>
