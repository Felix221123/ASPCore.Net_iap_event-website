@page
@model EventsModel
@{
    ViewData["Title"] = "Event page";
}

@{
    Layout = null; // This disables the layout for this page
}


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - soft20181_starter</title>

    <!-- google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <!-- portfolio / desktop icon -->
    <link rel="icon" type="image/webp" sizes="32x32" href="/assets/img/portfolio-site-icon.webp">

    <!-- tailwind css reset -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true">

    @* Section for CSS Start *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@
    <link rel="stylesheet" href="~/css/pagestyles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/soft20181_starter.styles.css" asp-append-version="true" />
    @* Section for CSS Start *@
</head>

<body>

    @* Header Section Start *@
    <section class="hero-section-events bg-no-repeat bg-center bg-cover w-full relative top-0"
        style="background-image: url(/assets/img/event-bg.jpg);">
        <!-- header section -->
        <header>
            <!-- logo -->
            <div class="logo font-bold"> <span class="logo-name1">Ur</span><span class="logo-name2">Net</span><span
                    class="logo-name1">Tribe</span></div>
            <!-- navigation -->
            <nav>
                <div id="close-tbn" style="color: red;opacity: 0.7;">&times;</div>
                <ul id="my-list-of-headers">
                    <li><a asp-page="/Index">Home</a></li>
                    <li><a asp-page="/Users/Events">Event</a></li>
                    <li><a asp-page="/Users/Contacts">Contact</a></li>
                </ul>
                @* profile on the right side of the header on mobile *@
                <a href="/Users/Profile" class="profile-container-mobile cursor-pointer" id="avatar">
                    <span class="avatar-initials">@Model.UserAbbreviation</span>
                </a>
            </nav>
            <!-- event reservation button -->
            <button class="btn-reserve font-semibold uppercase cursor-pointer">
                Dark <img src="../assets/svg/moon.svg" alt="moon icon" id="dark-icon">
            </button>
            <!-- font size controls -->
            <div class="font-size-controls">
                <button id="increase-font" class="font-control-btn">A+</button>
                <button id="reset-font" class="font-control-btn">A</button>
                <button id="decrease-font" class="font-control-btn">A-</button>
            </div>
            @* profile on the right side of the header on desktop *@
            <a asp-page="/Users/Profile" class="profile-container cursor-pointer">
                <span class="avatar-initials">@Model.UserAbbreviation</span>
            </a>
            <!-- hamburger menu -->
            <img src="../assets/svg/menu.svg" alt="menu button to open navigation" class="hamburger-menu">
        </header>

        <!-- main header -->
        <article class="header-event uppercase font-bold">Are you ready to choose your next event?</article>

    </section>

    <!-- search container -->
    <div class="searchContainer">
        <div class="formGroup">
            <form action="">
                <!-- event search container -->
                <div class="eventSearchContainer">
                    <!-- event title -->
                    <label for="eventtitle" class="dark-mode-clr"> Search Event
                        <input type="text" id="eventtitle" placeholder="Event Title">
                    </label>
                </div>
                <!-- event location/place container -->
                <div class="eventSearchContainer">
                    <!-- event title -->
                    <label for="place" class="dark-mode-clr"> Place
                        <input type="text" id="place" placeholder="Nottingham">
                    </label>
                </div>
            </form>
        </div>
    </div>

    <!-- filtering and sorting container -->
    <div class="filter-sort-container">
    <div class="filterContainer"></div>
    <div class="sortContainer cursor-pointer dark-mode-clr">
        Sort by Date <img src="/assets/svg/Sort_arrow.svg" alt="sort icon">
    </div>
    </div>

    <!-- event cards -->
    <div class="eventsContainer">
    </div>

    <!-- search results -->
    <div class="searchResultsContainer" style="display: none;">
    </div>

    <!-- preloader  -->
    <!-- preloader for contents/ seearch results -->
    <div class="preloader-container" style="display: none;">
        <div class="wrap">
            <div class="ball"></div>
            <div class="ball"></div>
            <div class="ball"></div>
        </div>
    </div>



    @* brands section *@
    <section class="join-these-brands">
        <div class="sectionHeader">
            <h2 class="font-semibold dark-mode-clr">Join these brands</h2>
            <p class="description dark-mode-clr">We've had the pleasure of working with industry-defining brands. These are just some of them.</p>
        </div>
        <div class="brandsImages">
            <img src="../assets/svg/microsoft.svg" alt="microsoft logo">
            <img src="../assets/svg/spotify-brand.svg" alt="spotify logo">
            <img src="../assets/svg/stripe.svg" alt="stripe logo">
            <img src="../assets/svg/uber.svg" alt="uber logo">
            <img src="../assets/svg/google.svg" alt=" google icon">
            <img src="../assets/svg/grab.svg" alt="grab logo">
            <img src="../assets/svg/medium.svg" alt="medium logo">
            <img src="../assets/svg/youtube.svg" alt="youtube logo">
            <img src="../assets/svg/zoom.svg" alt="zoom icon">
        </div>
    </section>

    @* Footer Section Start *@
    <footer>
        <div class="footerSection">
            <!-- first column -->
            <div class="logoSection">
                <div class="logo font-bold"> <span class="logo-name1">Ur</span><span class="logo-name2">Net</span><span
                        class="logo-name1">Tribe</span></div>
                <p class="description">
                    UrNetTribe is a global self-service ticketing platform for live events. We connect students,
                    graduates, and professionals with employers across the world.
                </p>
                <div class="socialIcons">
                    <img src="~/assets/svg/facebook-icon.svg" alt="facebook icon">
                    <img src="~/assets/svg/twitter-icon.svg" alt="twitter icon">
                    <img src="~/assets/svg/linkedin-icon.svg" alt="linkedin icon">
                </div>
            </div>
            <!-- second column -->
            <div class="navLinks">
                <article class="font-semibold">Links</article>
                <ul>
                    <li><a asp-page="/Index">Home</a></li>
                    <li><a asp-page="/Users/Events">Event</a></li>
                    <li><a asp-page="/Users/Contacts">Contact</a></li>
                </ul>
            </div>
            <!-- third column -->
            <div class="mailSection">
                <article class="font-medium">Stay in the loop</article>
                <p class="description font-normal">Sign up for our newsletter to get the latest news and updates.</p>
                <div class="mailBox">
                    <label for="emailAddress">
                        <input type="text" id="emailAddress" placeholder="Email Address">
                        <button class="subscribe font-semibold" type="submit">Sign Up</button>
                    </label>
                </div>

            </div>
        </div>
        <div class="copyright text-center">
            Copyright ©2025 <a href="https://felixbaah.com/" target="_blank">Felix Baah</a>
        </div>
    </footer>


    @* Add Site Wide JavaScript Start *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Add Site Wide JavaScript End *@
</body>

</html>
