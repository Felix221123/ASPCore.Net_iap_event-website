@page
@model soft20181_starter.Pages.Users.RegisterModel
@{
    ViewData["Title"] = "Register page";
}
@{
    Layout = null; // This disables the layout for this page
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - soft20181_starter</title>

    <!-- google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <!-- portfolio / desktop icon -->
    <link rel="icon" type="image/webp" sizes="32x32" href="/assets/img/portfolio-site-icon.webp">

    <!-- tailwind css reset -->
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true">

    @* Section for CSS Start *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@
    <link rel="stylesheet" href="~/css/pagestyles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/soft20181_starter.styles.css" asp-append-version="true" />
    @* Section for CSS Start *@
</head>

<body style="background-color: #10141E;">
    <div class="main-body-container">
        <header class="text-center">
            <h1>Create your UrNetTribe Account</h1>
        </header>

        <!-- Sign Up Container -->
        <div class="login-form-container">
            <form method="post" asp-page="/Users/Register" novalidate>
                <div class="name-field">
                    <label asp-for="@Model.Input.FirstName">
                        <input type="text" asp-for="@Model.Input.FirstName" placeholder="First Name">
                        <span asp-validation-for="@Model.Input.FirstName" class="errorStyle">Invalid Name</span>
                    </label>
                    <label asp-for="@Model.Input.LastName">
                        <input type="text" asp-for="@Model.Input.LastName" placeholder="Last Name">
                        <span asp-validation-for="@Model.Input.LastName" class="errorStyle">Invalid Name</span>
                    </label>
                </div>
                <div class="email-field">
                    <label asp-for="@Model.Input.Email">
                        <input type="text" asp-for="@Model.Input.Email" placeholder="Email address">
                        <span asp-validation-for="@Model.Input.Email" class="errorStyle">Invalid Email</span>
                    </label>
                    <label asp-for="@Model.Input.Password">
                        <input type="password" asp-for="@Model.Input.Password" placeholder="Password">
                        <span asp-validation-for="@Model.Input.Password" class="errorStyle">Incorrect password</span>
                    </label>
                </div>
                <input type="submit" value="Create an account">
            </form>
            <div class="users-signup-option">
                <p class="signup-asked">Already have an account?</p>
                <p class="signup-link"><a asp-page="/Users/LogIn">Login</a></p>
            </div>
        </div>
    </div>

    @* Add Site Wide JavaScript Start *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    @* Add Site Wide JavaScript End *@
</body>

</html>
