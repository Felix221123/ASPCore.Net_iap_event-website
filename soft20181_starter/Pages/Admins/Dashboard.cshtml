@page
@model DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
@{
    Layout = null; // This disables the layout for this page
}





<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - soft20181_starter</title>

    <!-- google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <!-- portfolio / desktop icon -->
    <link rel="icon" type="image/webp" sizes="32x32" href="/assets/img/portfolio-site-icon.webp">

    <!-- tailwind css reset -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true">

    <!-- tailwind css reset -->
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true">


    @* Section for CSS Start *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@
    <link rel="stylesheet" href="~/soft20181_starter.styles.css" asp-append-version="true" />
    @* Section for CSS Start *@

    <style>
    #success-popup {
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        background-color: rgba(0, 0, 0, 0.7);
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .popup-content {
        background: white;
        padding: 2rem;
        border-radius: 1rem;
        max-width: 400px;
        width: 90%;
        animation: fadeIn 0.5s ease-in-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

</head>
<body style="background-color: #141D2F;" id="adminDashboard">
    <div class="mainAdminDashboard">
        @* header for admins, including their login and logout *@
        <h1 class="font-bold text-center">Admin Dashboard</h1> 
        <header>
            <button type="button" id="showAddEventBtn" class="btn btn-primary mb-3">Add Event</button>


            <form method="post" asp-page-handler="Logout">
                <button type="submit" class="btn btn-danger">Log Out</button>
            </form>
        </header>




        <h2 class="font-bold text-center">All Events</h2>

        @* here is the al events *@
        <div class="allEvents">
            @if (Model.AllEvents.Any())
            {
                <ul class="list-unstyled">
                    @foreach (var ev in Model.AllEvents)
                    {
                        <li class="d-flex justify-content-between align-items-center border-bottom py-2" id="openUpdateForm">
                            <span class="event-title cursor-pointer" data-event-id="@ev.EventID"
                            data-name="@ev.Name" data-images="@ev.Images"
                            data-description="@ev.Description" data-type="@ev.Type" data-day="@ev.Day" data-month="@ev.Month"
                            data-year="@ev.Year" data-time="@ev.Time" data-venue-name="@ev.VenueName" data-venue-address="@ev.VenueAddress"
                            data-organizer-name="@ev.OrganizerName" data-organizer-contact="@ev.OrganizerContact" data-follow-link="@ev.FollowLink"
                            data-ticket-price="@ev.TicketPrice" data-currency="@ev.Currency" data-event-link="@ev.EventLink">
                                @ev.Name
                            </span>
                            <form method="post" asp-page-handler="DeleteEvent" asp-route-id="@ev.EventID" class="m-0">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-center text-white font-bold">No events found.</p>
            }
        </div>




        @* container for events adding *@
        <div id="eventFormContainer" style="display: none;" class="bg-light text-dark p-4 rounded mb-4 shadow-sm">
            <h2 class="font-bold text-center">Add Event</h2>

            @* scrollable container *@
            <div style="max-height: 70vh; overflow-y: auto; padding-right: 10px;">
                <form method="post" asp-page="/Admins/Dashboard">

                    <!-- Event Name -->
                    <div class="form-floating mb-3">
                        <input asp-for="Event.Name" class="form-control" placeholder="Input Name" />
                        <label asp-for="Event.Name"></label>
                    </div>

                    <!-- Description -->
                    <div class="form-floating mb-3">
                        <textarea asp-for="Event.Description" class="form-control" style="height: 120px;" placeholder="Description"></textarea>
                        <label asp-for="Event.Description"></label>
                    </div>

                    <!-- Type -->
                    <div class="form-floating mb-3">
                        <input asp-for="Event.Type" class="form-control" placeholder="Type (e.g., Tour)" />
                        <label asp-for="Event.Type"></label>
                    </div>

                    <!-- Date Fields: Day, Month, Year -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4 form-floating">
                            <input asp-for="Event.Day" class="form-control" placeholder="Day" />
                            <label asp-for="Event.Day"></label>
                        </div>
                        <div class="col-md-4 form-floating">
                            <input asp-for="Event.Month" class="form-control" placeholder="Month" />
                            <label asp-for="Event.Month"></label>
                        </div>
                        <div class="col-md-4 form-floating">
                            <input asp-for="Event.Year" class="form-control" placeholder="Year" />
                            <label asp-for="Event.Year"></label>
                        </div>
                    </div>

                    <!-- Time -->
                    <div class="form-floating mb-3">
                        <input asp-for="Event.Time" class="form-control" placeholder="Time (e.g. 15:00 - 17:00 GMT)" />
                        <label asp-for="Event.Time"></label>
                    </div>

                    <!-- Venue Name -->
                    <div class="form-floating mb-3">
                        <input asp-for="Event.VenueName" class="form-control" placeholder="Venue Name" />
                        <label asp-for="Event.VenueName"></label>
                    </div>

                    <!-- Venue Address -->
                    <div class="form-floating mb-3">
                        <textarea asp-for="Event.VenueAddress" class="form-control" style="height: 80px;" placeholder="Venue Address"></textarea>
                        <label asp-for="Event.VenueAddress"></label>
                    </div>

                    <!-- Organizer Name -->
                    <div class="form-floating mb-3">
                        <input asp-for="Event.OrganizerName" class="form-control" placeholder="Organizer Name" />
                        <label asp-for="Event.OrganizerName"></label>
                    </div>

                    <!-- Organizer Contact -->
                    <div class="form-floating mb-3">
                        <input asp-for="Event.OrganizerContact" class="form-control" placeholder="Organizer Contact" />
                        <label asp-for="Event.OrganizerContact"></label>
                    </div>

                    <!-- Follow Link -->
                    <div class="form-floating mb-3">
                        <input asp-for="Event.FollowLink" class="form-control" placeholder="Follow Link" />
                        <label asp-for="Event.FollowLink"></label>
                    </div>

                    <!-- Ticket Price -->
                    <div class="form-floating mb-3">
                        <input asp-for="Event.TicketPrice" class="form-control" placeholder="Ticket Price" />
                        <label asp-for="Event.TicketPrice"></label>
                    </div>

                    <!-- Currency -->
                    <div class="form-floating mb-3">
                        <input asp-for="Event.Currency" class="form-control" placeholder="Currency (e.g., USD)" />
                        <label asp-for="Event.Currency"></label>
                    </div>

                    <!-- Input Link -->
                    <div class="form-floating mb-3">
                        <input asp-for="Event.EventLink" class="form-control" placeholder="Input Link" />
                        <label asp-for="Event.EventLink"></label>
                    </div>

                    <!-- Images JSON -->
                    <div class="mb-3">
                        <label asp-for="Event.Images" class="form-label">Images (JSON format)</label>
                        <textarea asp-for="Event.Images"
                                class="form-control"
                                style="height: 80px;"
                                placeholder='[{"url":"...","alt":"..."}]'></textarea>
                    </div>


                    <!-- Save + Cancel -->
                    <div class="mt-4 d-flex justify-content-end gap-3">
                        <button type="submit" class="btn btn-success add-event">Save</button>
                        <button type="button" class="btn btn-secondary" id="cancelEventBtn">Cancel</button>
                    </div>
                </form>
            </div>

        </div>

         @if (TempData["EventSaved"] != null && (bool)TempData["EventSaved"])
        {
            <div id="success-popup">
                <div class="popup-content text-center p-4 bg-success text-white rounded shadow">
                    <h2>🎉 Event Saved Successfully!</h2>
                    <p>Your event has been added to the List Of Events.</p>
                    <button id="closePopup" class="btn btn-light mt-2">Close</button>
                </div>
            </div>
        }


        @* container for events adding *@
        <div id="UpdateEventFormContainer" style="display: none;" class="bg-light text-dark p-4 rounded mb-4 shadow-sm">
            <h2 class="font-bold text-center">Update Event</h2>

            @* scrollable container *@
            <div style="max-height: 70vh; overflow-y: auto; padding-right: 10px;">
                <form method="post" asp-page-handler="UpdateEvent" asp-for="UpdateEvent" asp-prefix="UpdateEvent">
                    <input type="hidden" asp-for="UpdateEvent.EventID" />

                    <!-- Event Name -->
                    <div class="form-floating mb-3">
                        <input asp-for="UpdateEvent.Name" class="form-control" placeholder="UpdateEvent Name" />
                        <label asp-for="UpdateEvent.Name"></label>
                    </div>

                    <!-- Description -->
                    <div class="form-floating mb-3">
                        <textarea asp-for="UpdateEvent.Description" class="form-control" style="height: 120px;" placeholder="Description"></textarea>
                        <label asp-for="UpdateEvent.Description"></label>
                    </div>

                    <!-- Type -->
                    <div class="form-floating mb-3">
                        <input asp-for="UpdateEvent.Type" class="form-control" placeholder="Type (e.g., Tour)" />
                        <label asp-for="UpdateEvent.Type"></label>
                    </div>

                    <!-- Date Fields: Day, Month, Year -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4 form-floating">
                            <input asp-for="UpdateEvent.Day" class="form-control" placeholder="Day" />
                            <label asp-for="UpdateEvent.Day"></label>
                        </div>
                        <div class="col-md-4 form-floating">
                            <input asp-for="UpdateEvent.Month" class="form-control" placeholder="Month" />
                            <label asp-for="UpdateEvent.Month"></label>
                        </div>
                        <div class="col-md-4 form-floating">
                            <input asp-for="UpdateEvent.Year" class="form-control" placeholder="Year" />
                            <label asp-for="UpdateEvent.Year"></label>
                        </div>
                    </div>

                    <!-- Time -->
                    <div class="form-floating mb-3">
                        <input asp-for="UpdateEvent.Time" class="form-control" placeholder="Time (e.g. 15:00 - 17:00 GMT)" />
                        <label asp-for="UpdateEvent.Time"></label>
                    </div>

                    <!-- Venue Name -->
                    <div class="form-floating mb-3">
                        <input asp-for="UpdateEvent.VenueName" class="form-control" placeholder="Venue Name" />
                        <label asp-for="UpdateEvent.VenueName"></label>
                    </div>

                    <!-- Venue Address -->
                    <div class="form-floating mb-3">
                        <textarea asp-for="UpdateEvent.VenueAddress" class="form-control" style="height: 80px;" placeholder="Venue Address"></textarea>
                        <label asp-for="UpdateEvent.VenueAddress"></label>
                    </div>

                    <!-- Organizer Name -->
                    <div class="form-floating mb-3">
                        <input asp-for="UpdateEvent.OrganizerName" class="form-control" placeholder="Organizer Name" />
                        <label asp-for="UpdateEvent.OrganizerName"></label>
                    </div>

                    <!-- Organizer Contact -->
                    <div class="form-floating mb-3">
                        <input asp-for="UpdateEvent.OrganizerContact" class="form-control" placeholder="Organizer Contact" />
                        <label asp-for="UpdateEvent.OrganizerContact"></label>
                    </div>

                    <!-- Follow Link -->
                    <div class="form-floating mb-3">
                        <input asp-for="UpdateEvent.FollowLink" class="form-control" placeholder="Follow Link" />
                        <label asp-for="UpdateEvent.FollowLink"></label>
                    </div>

                    <!-- Ticket Price -->
                    <div class="form-floating mb-3">
                        <input asp-for="UpdateEvent.TicketPrice" class="form-control" placeholder="Ticket Price" />
                        <label asp-for="UpdateEvent.TicketPrice"></label>
                    </div>

                    <!-- Currency -->
                    <div class="form-floating mb-3">
                        <input asp-for="UpdateEvent.Currency" class="form-control" placeholder="Currency (e.g., USD)" />
                        <label asp-for="UpdateEvent.Currency"></label>
                    </div>

                    <!-- UpdateEvent Link -->
                    <div class="form-floating mb-3">
                        <input asp-for="UpdateEvent.EventLink" class="form-control" placeholder="UpdateEvent Link" />
                        <label asp-for="UpdateEvent.EventLink"></label>
                    </div>

                    <!-- Images JSON -->
                    <div class="mb-3">
                        <label asp-for="UpdateEvent.Images" class="form-label">Images (JSON format)</label>
                        <textarea asp-for="UpdateEvent.Images"
                                class="form-control"
                                style="height: 80px;"
                                placeholder='[{"url":"...","alt":"..."}]'></textarea>
                    </div>


                    <!-- Save + Cancel -->
                    <div class="mt-4 d-flex justify-content-end gap-3">
                        <button type="submit" class="btn btn-warning">Update Event</button>
                        <button type="button" class="btn btn-secondary" id="cancelUpdateEventBtn">Cancel</button>
                    </div>
                </form>
            </div>
        </div>

        @if (TempData["EventUpdated"] != null && (bool)TempData["EventUpdated"])
        {
            <div id="success-popup">
                <div class="popup-content text-center p-4 bg-success text-white rounded shadow">
                    <h2>🎉 Event Saved Successfully!</h2>
                    <p>Your event has been added to the List Of Events.</p>
                    <button id="closePopup" class="btn btn-light mt-2">Close</button>
                </div>
            </div>
        }



        @* Users section for update *@
        <h2 class="font-bold text-center">Users Account</h2>

        <div class="usersAccountSection">
            @if (Model.AllUsers.Any())
            {
                <ul class="list-unstyled">
                    @foreach (var user in Model.AllUsers)
                    {
                        <li class="d-flex justify-content-between align-items-center border-bottom py-2 text-white">
                            <span class="cursor-pointer user-email" data-user-id="@user.UserID"
                                data-firstname="@user.FirstName"
                                data-lastname="@user.LastName"
                                data-email="@user.Email"
                                data-password="@user.Password">
                                @user.Email
                            </span>
                            <form method="post" asp-page-handler="DeleteUser" asp-route-id="@user.UserID" class="m-0">
                                <button type="submit" class="btn btn-danger btn-sm">Delete Account</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-white text-center">No users found.</p>
            }
        </div>

        @* updating users container *@
        <div id="userUpdateFormContainer" style="display: none;" class="bg-light text-dark p-4 rounded mb-4 shadow-sm mt-4">
            <h2 class="font-bold text-center">Update User Profile</h2>
            <form method="post" asp-page-handler="UpdateUser">
                <input type="hidden" asp-for="SelectedUser.UserID" id="UserID" />

                <div class="form-floating mb-3">
                    <input asp-for="SelectedUser.FirstName" class="form-control" id="UserFirstName" />
                    <label asp-for="SelectedUser.FirstName">First Name</label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="SelectedUser.LastName" class="form-control" id="UserLastName" />
                    <label asp-for="SelectedUser.LastName">Last Name</label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="SelectedUser.Email" class="form-control" id="UserEmail" />
                    <label asp-for="SelectedUser.Email">Email</label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="SelectedUser.Password" class="form-control" placeholder="Enter new password (leave blank to keep current)" />
                    <label asp-for="SelectedUser.Password">New Password (optional, leave blank to keep current)</label>
                </div>


                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-success">Update</button>
                    <button type="button" class="btn btn-secondary" id="cancelUserBtn">Cancel</button>
                </div>
            </form>
        </div>


        @* view users messages for the company *@
        <h2 class="font-bold text-center">Users Messages</h2>

        <div class="usersAccountSection">
            @if (Model.AllMessages.Any())
            {
                <ul class="list-unstyled">
                    @foreach (var message in Model.AllMessages)
                    {
                        <li class="d-flex justify-content-between align-items-center border-bottom py-2 text-white">
                            <span class="cursor-pointer message-email" 
                                data-message-id="@message.MessageID"
                                data-fullname="@message.FullName"
                                data-email="@message.Email"
                                data-phone="@message.PhoneNumber"
                                data-message="@message.Message"
                                data-sentat="@message.SentAt.ToString("yyyy-MM-dd HH:mm:ss")">
                                @message.Email
                            </span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-white text-center">No messages found.</p>
            }
        </div>

        @* Bootstrap Modal for Message Details *@
        <div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="messageModalLabel">Contact Message Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" class="form-control" id="modalFullName" readonly>
                    </div>
                    <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="text" class="form-control" id="modalEmail" readonly>
                    </div>
                    <div class="mb-3">
                    <label class="form-label">Phone Number</label>
                    <input type="text" class="form-control" id="modalPhoneNumber" readonly>
                    </div>
                    <div class="mb-3">
                    <label class="form-label">Sent At</label>
                    <input type="text" class="form-control" id="modalSentAt" readonly>
                    </div>
                    <div class="mb-3">
                    <label class="form-label">Message</label>
                    <textarea class="form-control" id="modalMessage" rows="5" readonly></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
            </div>
        </div>
        </div>


    </div>



    @* Add Site Wide JavaScript Start *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Add Site Wide JavaScript End *@


</body>
</html>